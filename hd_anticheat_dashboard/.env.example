# Copy to .env and fill in before running `npm start`.

# Port the dashboard (frontend + API) listens on.
PORT=3050

# Public base URL this service is reachable at — used to build the
# screenshot upload URLs handed to buyers' FXServers, and the image
# URLs embedded in Discord ban embeds. Must be reachable by both
# Discord's servers and your buyers' game clients, so it needs to be a
# real public HTTPS URL in production, not localhost.
PUBLIC_URL=http://localhost:3050

# Signs browser login sessions (dashboard JWT cookie/token). Any long
# random string — generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_JWT_SECRET=change-me

# Signs short-lived, single-purpose screenshot upload tokens. Separate
# from SESSION_JWT_SECRET on purpose — this one's scope is narrow
# (one license, one ban event, ~60 seconds), so rotating it doesn't log
# out every buyer.
UPLOAD_JWT_SECRET=change-me-too

# Protects POST /api/admin/licenses (minting new licenses over HTTP
# instead of via `npm run mint-license`). Leave blank to disable that
# route entirely and only ever mint licenses with the CLI script.
ADMIN_SECRET=
